{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CET-6 Listener",
      "type": "debugpy",
      "request": "launch",
      "module": "cet6_listener.commands.app",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": ["run", "--audio", "data-bin/audio/test.mp3", "--dry-run"]
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": ["-q"]
    }
  ]
}
